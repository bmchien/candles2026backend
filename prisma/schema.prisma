// Prisma schema — follows the HLD data model (section 4).
// Table / column names are snake_case in PostgreSQL, camelCase in TypeScript.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

enum ProductStatus {
  IN_STOCK
  OUT_OF_STOCK
}

// Scent family shown on the scent showcase page.
enum ScentType {
  PERFUME // Hương nước hoa
  NATURAL // Hương tự nhiên
}

enum ShippingMethod {
  PICKUP
  DELIVERY
}

// Handmade-order lifecycle (see src/orders/order-status.ts for the allowed transitions).
enum OrderStatus {
  AWAITING_DEPOSIT // Chờ cọc
  DEPOSITED // Đã cọc
  IN_PRODUCTION // Đang làm
  COMPLETED // Đã hoàn thành (made, ready to hand over)
  SHIPPING // Đang giao
  DELIVERED // Đã giao
  CANCELLED // Huỷ
}

model User {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cart   Cart?
  orders Order[]

  @@index([role])
  @@map("users")
}

model Category {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Tag {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products ProductTag[]

  @@map("tags")
}

model Product {
  id               BigInt        @id @default(autoincrement())
  code             String        @unique @db.VarChar(64)
  name             String        @db.VarChar(255)
  shortDescription String?       @map("short_description") @db.VarChar(500)
  description      String?       @db.Text
  categoryId       BigInt        @map("category_id")
  price            Decimal       @db.Decimal(12, 2)
  discountType     DiscountType  @default(NONE) @map("discount_type")
  discountValue    Decimal       @default(0) @map("discount_value") @db.Decimal(12, 2)
  discountStart    DateTime?     @map("discount_start")
  discountEnd      DateTime?     @map("discount_end")
  status           ProductStatus @default(IN_STOCK)
  isActive         Boolean       @default(true) @map("is_active")
  // Admin-chosen position in the storefront (1 = first). NULL = not pinned: shown after the
  // ordered ones, newest first.
  displayOrder     Int?          @map("display_order")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags       ProductTag[]
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([name])
  @@index([categoryId])
  @@index([status])
  @@index([isActive])
  @@index([price])
  @@index([isActive, createdAt])
  @@index([displayOrder, createdAt])
  @@map("products")
}

model ProductTag {
  productId BigInt @map("product_id")
  tagId     BigInt @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

model ProductImage {
  id        BigInt   @id @default(autoincrement())
  productId BigInt   @map("product_id")
  url       String   @db.VarChar(1000)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

// A cart belongs to exactly one owner: a user (user_id) or a guest (guest_token_hash).
// The CHECK constraint carts_single_owner_check (see migration) enforces this in PostgreSQL.
model Cart {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt?  @unique @map("user_id")
  // SHA-256 (hex) of the guest cart token; the token itself is never stored.
  guestTokenHash String?  @unique @map("guest_token_hash") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id        BigInt   @id @default(autoincrement())
  cartId    BigInt   @map("cart_id")
  productId BigInt   @map("product_id")
  quantity  Int
  // Customer's note for this line (colour, scent, message…); copied to the order item.
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id             BigInt         @id @default(autoincrement())
  userId         BigInt         @map("user_id")
  shippingMethod ShippingMethod @map("shipping_method")
  customerName   String         @map("customer_name") @db.VarChar(100)
  customerPhone  String         @map("customer_phone") @db.VarChar(20)
  provinceCode   String?        @map("province_code") @db.VarChar(20)
  provinceName   String?        @map("province_name") @db.VarChar(255)
  wardCode       String?        @map("ward_code") @db.VarChar(20)
  wardName       String?        @map("ward_name") @db.VarChar(255)
  detailAddress  String?        @map("detail_address") @db.VarChar(500)
  // Date the customer would like to receive the order (Vietnam calendar day). NULL for old orders.
  desiredDate    DateTime?      @map("desired_date") @db.Date
  totalAmount    Decimal        @map("total_amount") @db.Decimal(14, 2)
  status         OrderStatus    @default(AWAITING_DEPOSIT)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([desiredDate])
  @@map("orders")
}

model OrderItem {
  id          BigInt  @id @default(autoincrement())
  orderId     BigInt  @map("order_id")
  // Nullable so that hard-deleting a product never rewrites order history;
  // product_name / product_code / price keep the snapshot at purchase time.
  productId   BigInt? @map("product_id")
  productName String  @map("product_name") @db.VarChar(255)
  productCode String  @map("product_code") @db.VarChar(64)
  price       Decimal @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal @db.Decimal(14, 2)
  // Customer's note for this product, copied from the cart at checkout.
  note        String? @db.VarChar(500)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Scents shown on the public showcase page (display only, not sold directly).
model Scent {
  id          BigInt    @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String    @db.Text
  type        ScentType
  // http(s) URL of an image hosted elsewhere
  imageUrl    String?   @map("image_url") @db.VarChar(1000)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isActive, type])
  @@map("scents")
}
