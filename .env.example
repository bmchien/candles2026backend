# --- Database (Neon PostgreSQL) ---------------------------------------------
# Pooled connection string used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct (non-pooled) connection used by Prisma Migrate. On Neon this is the
# host WITHOUT "-pooler". If you are not using a pooler, set it to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Auth --------------------------------------------------------------------
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# --- HTTP --------------------------------------------------------------------
FRONTEND_URL="http://localhost:3000"
PORT=3001
# Public base URL of this API, used to build URLs of uploaded images.
APP_URL="http://localhost:3001"
NODE_ENV="development"
# Number of reverse-proxy hops to trust for client IPs (rate limiting / logs).
TRUST_PROXY=1

# --- Rate limiting (requests per window, window in ms) ------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# --- Uploads (local disk storage driver) --------------------------------------
UPLOAD_DIR="uploads"
UPLOAD_MAX_SIZE_MB=5

# --- Address provider --------------------------------------------------------
ADDRESS_API_BASE_URL="https://provinces.open-api.vn/api/v2"

# --- Logging -----------------------------------------------------------------
LOG_LEVEL="info"

# --- Tests (npm run test:e2e) ------------------------------------------------
# A SEPARATE, disposable database: e2e tests TRUNCATE all tables in it.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME_test?sslmode=require"

# --- Seed (used only by `npm run seed`) ----------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-admin-password"
SEED_ADMIN_NAME="Quản trị viên"
SEED_CUSTOMER_PASSWORD="change-me-customer-password"
